{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jevbox",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/make"
    ]
  },
  "routes": [
    {
      "pattern": "jevbox.grahammiles.me",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "GENERATOR",
      "service": "beatbox"
    }
  ],
  "observability": {
    "enabled": true
  }
}
